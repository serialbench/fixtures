{
  "$schema": "https://json-schema.org/draft/2020-12/format-assertion",
  "title": "canonical config document (small)",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "type": "object",
      "required": ["database", "cache"],
      "properties": {
        "database": {
          "type": "object",
          "required": ["host", "port", "name", "user", "password"],
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer" },
            "name": { "type": "string" },
            "user": { "type": "string" },
            "password": { "type": "string" }
          }
        },
        "cache": {
          "type": "object",
          "required": ["enabled", "ttl"],
          "properties": {
            "enabled": { "type": "boolean" },
            "ttl": { "type": "integer" }
          }
        }
      }
    }
  }
}
